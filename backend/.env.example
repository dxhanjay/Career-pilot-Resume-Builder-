# ---------------------------------------------------------------------------
# CareerPilot AI — backend environment variables
#
# Copy to `.env` for local development. `.env` is gitignored; this file is not.
#
# This file is the CONTRACT for what the application expects. When you add a
# configuration value, add it here in the same commit — an undocumented
# environment variable is a deployment that fails for a reason nobody can see.
#
# No real secret ever belongs in this file. Placeholder values only.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# Active Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Railway injects PORT at runtime and the app MUST bind to it. Locally it
# defaults to 8080 (see application.yml). Hardcoding 8080 in production means
# the platform health check hits a port nothing is listening on, and the
# container is killed and restarted forever with no useful error.
PORT=8080

# --- Database --------------------------------------------------------------
#
# ⚠ Railway's PostgreSQL plugin exposes DATABASE_URL in libpq form:
#
#     postgresql://user:password@host:5432/railway
#
# That is NOT a valid JDBC URL. Handing it to Spring produces
# "Driver claims to not accept jdbcUrl", which reads like a driver problem and
# is actually a URL-format problem. Build the JDBC URL from the individual
# variables instead — see docs/phase-01-planning + the Phase 4 deployment guide.
#
# In the Railway dashboard, set these as reference variables:
#   SPRING_DATASOURCE_URL      = jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
#   SPRING_DATASOURCE_USERNAME = ${{Postgres.PGUSER}}
#   SPRING_DATASOURCE_PASSWORD = ${{Postgres.PGPASSWORD}}

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/careerpilot
SPRING_DATASOURCE_USERNAME=careerpilot
SPRING_DATASOURCE_PASSWORD=careerpilot

# HikariCP pool size. Keep this well under the database's max_connections:
# a container that opens 20 connections and a database that allows 22 leaves
# no headroom for migrations, psql, or a second instance during a rolling deploy.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- CORS ------------------------------------------------------------------
#
# Comma-separated exact origins. Never "*".
# A wildcard origin combined with credentials voids every other control on this
# list, and browsers will refuse the combination anyway.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Async job executor ----------------------------------------------------
# Sized in Phase 2, tuned in Phase 7 once real AI latency is known.
APP_ASYNC_CORE_POOL_SIZE=2
APP_ASYNC_MAX_POOL_SIZE=4
APP_ASYNC_QUEUE_CAPACITY=50

# --- Authentication (REQUIRED) ---------------------------------------------
#
# ⚠ JWT_SECRET has NO default. A missing value stops the application at startup,
# deliberately: a predictable signing key lets anyone mint a token claiming
# ROLE_ADMIN, and an application that "works" with a weak key has no symptom
# until it is exploited. Minimum 32 characters (256 bits) for HS256, enforced
# at startup by JwtProperties.
#
# Generate one with:
#   openssl rand -base64 48
#
# Use a DIFFERENT secret per environment. Rotating it invalidates every access
# token immediately (users simply refresh), so rotation is cheap - do it if you
# ever suspect exposure.
JWT_SECRET=replace-me-with-openssl-rand-base64-48-output-at-least-32-chars

# Durations use ISO-ish shorthand: 15m, 24h, 7d.
# Access-token TTL is the revocation delay: a suspended user keeps access until
# their current token expires. Shorter is safer and costs more refreshes.
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Whether unverified accounts may sign in. See AuthProperties for the trade:
# enforcing protects deliverability and blocks throwaway signups at the cost of
# activation. Config, not code - flip it without a deploy.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m
AUTH_VERIFICATION_TOKEN_TTL=24h
# Much shorter than verification: this token grants account takeover.
AUTH_PASSWORD_RESET_TOKEN_TTL=1h

# Used to build the links inside verification and reset emails. Must be the
# address a user's browser can actually reach - a localhost value here means
# every emailed link is broken in production.
APP_FRONTEND_BASE_URL=http://localhost:5173

# --- Transactional email ---------------------------------------------------
#
# Plain SMTP, so any provider works by changing these four values:
#   Gmail     smtp.gmail.com:587      (requires an App Password, not the account password)
#   Resend    smtp.resend.com:587     (username "resend", password = API key)
#   Brevo     smtp-relay.brevo.com:587
#   SendGrid  smtp.sendgrid.net:587   (username literally "apikey")
#   Mailgun   smtp.mailgun.org:587
#
# Local development defaults to a null SMTP port: sending is @Async and swallows
# delivery failures, so the application runs perfectly with no mail server. Run
# MailHog or Mailpit on 1025 if you want to see the messages.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# The From address. Must be on a domain you have verified with the provider, or
# messages are silently dropped or land in spam.
MAIL_FROM=no-reply@careerpilot.ai

# ---------------------------------------------------------------------------
# The values below are placeholders for later phases. They are listed now so
# the full configuration surface is visible in one place, but nothing reads
# them yet — do not populate them until the phase that introduces them.
# ---------------------------------------------------------------------------

# --- File storage -----------------------------------------------------------
#
# 'local' or 'cloudinary'.
#
# Local writes to disk and is DEVELOPMENT ONLY. On Railway the container
# filesystem is ephemeral, so every redeploy would silently delete every
# uploaded resume, and with more than one replica a file written by one
# container is invisible to the others. application-prod.yml hardcodes
# 'cloudinary' so a missing variable cannot degrade production into that state.
APP_STORAGE_PROVIDER=local

# Where LocalFileStorage writes. Blank means the system temp directory.
APP_STORAGE_LOCAL_DIR=

# Lifetime of a generated download URL, in seconds. A signed URL is a bearer
# credential for one file, and URLs leak through history, referrers, and
# screenshots - so this is minutes, not hours.
APP_STORAGE_SIGNED_URL_TTL=300

# Required only when APP_STORAGE_PROVIDER=cloudinary. CloudinaryConfig is not
# instantiated otherwise, so a developer on local storage needs no account.
# Find these on the Cloudinary dashboard under "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=careerpilot

# --- Resume limits ----------------------------------------------------------
# 5 MB. Also enforced by the servlet container before any application code runs,
# and by a CHECK constraint on the column.
APP_RESUME_MAX_FILE_SIZE=5242880

# A cost control as much as a product limit: every resume is a candidate for
# parsing and AI analysis, both of which cost money.
APP_RESUME_MAX_PER_USER=10

# NFR-PRIV-01 requires deletion within 30 days. The window exists so an
# accidental delete can be reversed by support.
APP_RESUME_PURGE_AFTER_DAYS=30

# --- Administrators ---------------------------------------------------------
#
# Comma-separated emails granted ROLE_ADMIN when the application starts.
#
# The first administrator of a fresh deployment has to come from somewhere, and
# the alternatives are worse: a seeded account with a default password is a
# well-known credential on every deployment that forgets to change it, and
# "first user to register wins" is a race anyone who finds the URL early can win.
#
# Register the account first, then set this and restart. Additive only —
# removing an address does NOT demote anyone.
APP_ADMIN_BOOTSTRAP_EMAILS=

# --- Job matching and interviews --------------------------------------------
#
# Nothing to configure. ATS scoring, job matching, and interview evaluation are
# deterministic rule engines (ADR-0029) and need no API key, no model, and no
# network. That is a product decision as much as a cost one: a score a student
# can reproduce and argue with is worth more than a slightly better one they
# cannot.

# --- Phase 7: AI ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL_PRIMARY=claude-opus-5
# CLAUDE_MODEL_FAST=claude-haiku-4-5
# AI_MONTHLY_CREDIT_CAP=50
