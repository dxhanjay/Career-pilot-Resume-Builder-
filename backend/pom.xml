<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The Spring Boot parent supplies dependency management for ~400 libraries.
        Because of it, most <dependency> entries below carry no <version> - the
        parent has already chosen a set of versions that are tested together.
        Overriding one of those versions manually is how you get a working build
        and a runtime NoSuchMethodError.

        Pin the parent to an exact version. Never use a range: a build that
        resolves differently tomorrow than it did today is not reproducible, and
        "it worked on my machine last week" becomes unanswerable.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.careerpilot</groupId>
    <artifactId>careerpilot-api</artifactId>
    <version>0.1.0</version>
    <name>CareerPilot AI API</name>
    <description>AI-powered resume analysis and mock interview platform</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versions NOT managed by the Spring Boot parent must be pinned here. -->
        <springdoc.version>2.8.6</springdoc.version>
        <archunit.version>1.4.1</archunit.version>
        <jacoco.version>0.8.12</jacoco.version>

        <!-- NFR-TEST-01: the build fails below this line coverage on the service layer. -->
        <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
    </properties>

    <dependencies>

        <!-- ============================================================
             WEB
             ============================================================ -->

        <!--
            Embedded Tomcat + Spring MVC + Jackson. This is the HTTP layer.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Jakarta Bean Validation (Hibernate Validator).

            Not optional. NFR-SEC-04 requires every request validated at the DTO
            boundary, and @Valid silently does nothing without this on the
            classpath - which is a failure mode that looks exactly like success
            until someone posts a 10 MB string into a VARCHAR(120).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             PERSISTENCE
             ============================================================ -->

        <!--
            Spring Data JPA + Hibernate + HikariCP connection pool.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            PostgreSQL JDBC driver. Scope 'runtime': application code never
            imports org.postgresql, so it has no business being on the compile
            classpath. Keeping it off means the compiler catches any accidental
            direct use of a vendor class.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Flyway - versioned, forward-only schema migrations.

            From Flyway 10 onward the PostgreSQL support lives in a separate
            artifact. flyway-core alone starts up and then fails at runtime with
            "Unsupported Database: PostgreSQL", which is a confusing error for a
            missing dependency. Both are required.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============================================================
             OPERATIONS
             ============================================================ -->

        <!--
            Actuator - health, info, metrics endpoints.

            NFR-OBS-02 and Railway's health check both depend on this. Exposure
            is restricted in application.yml; the starter being present does not
            mean every endpoint is public.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============================================================
             DOCUMENTATION
             ============================================================ -->

        <!--
            springdoc generates OpenAPI from the same annotations that drive
            validation and serialisation. That is the point: hand-written API
            docs drift from the code within one sprint. Generated docs cannot.

            Disabled in the prod profile - see application-prod.yml.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============================================================
             DEVELOPER TOOLING
             ============================================================ -->

        <!--
            Lombok - compile-time boilerplate generation.

            HOUSE RULE, enforced by review: never put @Data or @EqualsAndHashCode
            on a JPA entity. Both generate equals/hashCode over every field,
            which triggers lazy-loading on collections and breaks entity identity
            semantics in a Set. Use @Getter/@Setter explicitly on entities, and
            prefer Java records for DTOs - which need no Lombok at all.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             TEST
             ============================================================ -->

        <!-- JUnit 5, Mockito, AssertJ, Spring Test, JSONassert. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers integration, providing @ServiceConnection.

            Integration tests run against real PostgreSQL in Docker, never H2.
            H2 in "PostgreSQL compatibility mode" accepts SQL that PostgreSQL
            rejects and has different transaction, index, and type behaviour -
            so a green H2 suite is not evidence that production will work. The
            cost is that Docker must be running to execute integration tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            ArchUnit - architecture rules as executable tests.

            This is what stops Clean Architecture from decaying into a comment in
            the README. See ArchitectureTest.java.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!--
                Produces the executable fat jar. The Lombok exclusion keeps the
                annotation processor out of the runtime artifact - it is a
                compile-time tool and shipping it only enlarges the image.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                Surefire runs *Test (fast unit tests, no Spring context).
                Failsafe runs *IT (integration tests, Spring + Testcontainers).

                Splitting them matters: `mvn test` stays fast enough to run on
                every save, while `mvn verify` runs the full suite. A single
                suite that takes four minutes is a suite developers stop running.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!--
                JaCoCo enforces NFR-TEST-01.

                The check is currently advisory (haltOnFailure=false) because
                Phase 2 has almost no business logic to cover and a hard gate
                would block the build for a bad reason. Phase 3 introduces the
                first real service layer - flip this to true then, and never
                flip it back.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-service-layer-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>false</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.careerpilot.*.application.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
